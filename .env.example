# Exact DNS name that points to this server. Do not include a scheme or path.
APP_DOMAIN=evaluator.example.com

# This release supports one administrator account, not multi-user RBAC.
SONG_EVAL_USERNAME=admin
SONG_EVAL_PASSWORD_FILE=./secrets/admin_password.txt

# Read-only host directory mounted as /library in the application container.
SONG_EVAL_AUDIO_DIR=./audio

# Optional OpenAI-compatible evidence narration.
SONG_EVAL_LLM_BASE_URL=https://api.openai.com/v1
SONG_EVAL_LLM_MODEL=your-model-name
SONG_EVAL_LLM_API_KEY_FILE_HOST=./secrets/llm_api_key.txt
